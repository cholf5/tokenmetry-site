---
/**
 * 非默认语种入口（en 占根路径，见 pages/index.astro）。
 * 语种清单来自 LANGUAGES（src/i18n/ui.ts），新增语种 = 新增字典 + LANGUAGES 条目，无需改这里。
 */
import HomePage from '../../components/HomePage.astro';
import { locales, defaultLocale, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.filter((l) => l !== defaultLocale).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<HomePage locale={lang} />
