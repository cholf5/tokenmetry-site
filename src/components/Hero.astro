---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import { ui, type Locale } from '../i18n/ui';
import zhDark from '../assets/shots/overview-zh-dark.png';
import zhLight from '../assets/shots/overview-zh-light.png';
import enDark from '../assets/shots/overview-en-dark.png';
import enLight from '../assets/shots/overview-en-light.png';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const shot = locale === 'zh' ? { dark: zhDark, light: zhLight } : { dark: enDark, light: enLight };
---

<section class="hero">
  <div class="container">
    <div class="lead rise">
      <span class="pill"><Logo size={15}></Logo>Tokenmetry</span>
      <h1>{t.hero.title}</h1>
      <p class="sub">{t.hero.subtitle}</p>
      <div class="ctas">
        <a class="btn btn-primary btn-lg" href={site.releases} target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3.5v12M6.5 10.5 12 16l5.5-5.5M4.5 19.5h15"></path>
          </svg>
          {t.hero.download}</a>
        <a class="btn btn-ghost btn-lg" href={site.repo} target="_blank" rel="noopener">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 4.08 2.63 7.54 6.29 8.76.46.08.63-.2.63-.44v-1.7c-2.55.56-3.09-1.23-3.09-1.23-.42-1.06-1.02-1.34-1.02-1.34-.83-.57.06-.56.06-.56.92.06 1.4.94 1.4.94.82 1.4 2.14 1 2.66.76.08-.6.32-1 .58-1.23-2.01-.23-4.13-1.01-4.13-4.48 0-.99.35-1.8.93-2.44-.09-.23-.4-1.15.09-2.4 0 0 .76-.24 2.48.93a8.6 8.6 0 0 1 4.52 0c1.72-1.17 2.47-.93 2.47-.93.5 1.25.19 2.17.1 2.4.58.64.93 1.45.93 2.44 0 3.48-2.13 4.25-4.15 4.47.33.28.62.84.62 1.7v2.51c0 .24.17.53.64.44A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"></path>
          </svg>
          {t.hero.github}</a>
      </div>
      <p class="badges num">
        {t.hero.badges.join(' · ')}&ensp;·&ensp;{t.hero.platforms}
      </p>
    </div>

    <div class="shot-wrap rise rise-2">
      <div class="shot theme-dual">
        <Image
          src={shot.dark}
          alt={t.hero.shotAlt}
          widths={[880, 1280]}
          sizes="(max-width: 1080px) 100vw, 1032px"
          format="webp"
          class="t-dark"
          loading="eager"
          fetchpriority="high"
        />
        <Image
          src={shot.light}
          alt=""
          aria-hidden="true"
          widths={[880, 1280]}
          sizes="(max-width: 1080px) 100vw, 1032px"
          format="webp"
          class="t-light"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 72px 0 40px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: -240px 0 auto;
    height: 560px;
    background:
      radial-gradient(600px 320px at 68% -40px, var(--hero-glow), transparent 70%),
      radial-gradient(500px 300px at 12% -80px, var(--hero-glow), transparent 70%);
    pointer-events: none;
  }

  .lead {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    position: relative;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    border: 1px solid var(--line);
    background: var(--panel);
    border-radius: 999px;
    padding: 6px 13px;
    margin-bottom: 22px;
  }

  h1 {
    font-size: 44px;
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.16;
  }

  .sub {
    margin-top: 18px;
    font-size: 17px;
    color: var(--muted);
    max-width: 640px;
    margin-inline: auto;
  }

  .ctas {
    margin-top: 30px;
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .badges {
    margin-top: 18px;
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0.01em;
  }

  .shot-wrap {
    margin-top: 46px;
    position: relative;
  }

  .shot {
    border-radius: 14px;
    filter: drop-shadow(0 24px 60px rgba(2, 8, 20, 0.4));
  }

  [data-theme='light'] .shot {
    filter: drop-shadow(0 20px 46px rgba(30, 50, 90, 0.18));
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 44px;
    }

    h1 {
      font-size: 31px;
    }

    .sub {
      font-size: 15.5px;
    }

    .ctas :global(.btn) {
      width: 100%;
    }
  }
</style>
