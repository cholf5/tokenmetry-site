---
import { Image } from 'astro:assets';
import { ui, type Locale } from '../i18n/ui';
import trayZhDark from '../assets/shots/tray-zh-dark.png';
import trayZhLight from '../assets/shots/tray-zh-light.png';
import trayEnDark from '../assets/shots/tray-en-dark.png';
import trayEnLight from '../assets/shots/tray-en-light.png';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const shot = locale === 'zh' ? { dark: trayZhDark, light: trayZhLight } : { dark: trayEnDark, light: trayEnLight };
---

<section id="tray" class="full-bleed">
  <div class="container inner">
    <div class="txt">
      <span class="kicker">{t.tray.kicker}</span>
      <h2>{t.tray.title}</h2>
      <p class="sub">{t.tray.subtitle}</p>
      <ul class="points">
        {t.tray.points.map((p) => (
          <li>
            <span class="k mono">{p.k}</span>
            <span>{p.v}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="visual theme-dual">
      <Image
        src={shot.dark}
        alt={t.tray.shotAlt}
        widths={[420, 560]}
        sizes="(max-width: 900px) 92vw, 460px"
        format="webp"
        class="t-dark"
        loading="lazy"
      />
      <Image
        src={shot.light}
        alt=""
        aria-hidden="true"
        widths={[420, 560]}
        sizes="(max-width: 900px) 92vw, 460px"
        format="webp"
        class="t-light"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  section {
    padding: 72px 0;
  }

  .inner {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: 48px;
    align-items: center;
  }

  h2 {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .sub {
    margin-top: 12px;
    color: var(--muted);
    font-size: 15px;
  }

  .points {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .points li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: 14.5px;
    color: var(--muted);
  }

  .points .k {
    color: var(--text);
    font-weight: 700;
    font-size: 13px;
    border: 1px solid var(--line);
    background: var(--panel);
    border-radius: 7px;
    padding: 2px 9px;
    flex: 0 0 auto;
  }

  /* 真实弹层截图直接展示（不做任何 CSS 场景合成）；
     产品仓库日后产出真实桌面场景截图时，可直接替换此 Image 对（设计记录见 docs/plans/2026-10-26-landing-polish-design.md 改动二） */
  .visual {
    max-width: 460px;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(2, 8, 20, 0.3);
  }

  [data-theme='light'] .visual {
    box-shadow: 0 20px 44px rgba(30, 50, 90, 0.22);
  }

  @media (max-width: 900px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>
