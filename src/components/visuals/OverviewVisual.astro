---
/**
 * 总览视图复刻（原 assets/shots/overview-*.png，真机手记数字）。
 * 全窗外壳：macOS 标题栏 + 筛选栏 + 侧栏 + 四 KPI + 趋势/Agent 环 + 模型分布/类型环。
 * 设计稿宽 1280（--u 换算见 app-ui.css 头注）。
 */
import { ui, type VisualLocale } from '../../i18n/ui';
import { overview } from '../../data/app-demo';
import Mark from './Mark.astro';

interface Props {
  locale: VisualLocale;
}
const { locale } = Astro.props;
const t = ui[locale].app;
const o = overview;
const total = o.totalText[locale];

/* 趋势折线：Catmull-Rom → 三次贝塞尔 */
const W = 1060;
const L = 50;
const R = 10;
const TOP = 12;
const BOTTOM = 300;
const yMax = 450;
const xAt = (i: number) => L + (i * (W - L - R)) / (o.trendM.length - 1);
const yAt = (v: number) => BOTTOM - (v / yMax) * (BOTTOM - TOP);
const pts = o.trendM.map((v, i) => [xAt(i), yAt(v)] as const);
const linePath = (() => {
  let d = `M ${pts[0][0]} ${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[Math.max(0, i - 1)]!;
    const p1 = pts[i]!;
    const p2 = pts[i + 1]!;
    const p3 = pts[Math.min(pts.length - 1, i + 2)]!;
    const c1x = p1[0] + (p2[0] - p0[0]) / 6;
    const c1y = p1[1] + (p2[1] - p0[1]) / 6;
    const c2x = p2[0] - (p3[0] - p1[0]) / 6;
    const c2y = p2[1] - (p3[1] - p1[1]) / 6;
    d += ` C ${c1x.toFixed(2)} ${c1y.toFixed(2)}, ${c2x.toFixed(2)} ${c2y.toFixed(2)}, ${p2[0].toFixed(2)} ${p2[1].toFixed(2)}`;
  }
  return d;
})();

/* 环形段：自 12 点起顺时针 */
const C = 2 * Math.PI * 50;
const donut = (segs: { share: number; color: string }[]) =>
  segs.map((s, i) => ({
    dash: (s.share / 100) * C,
    offset: -segs.slice(0, i).reduce((a, b) => a + b.share, 0) * 0.01 * C,
    color: s.color,
  }));
const agentSegs = donut(o.agentDonut.segments);
const typeSegs = donut(o.typeDonut.segments);

const navIcons = [
  'M2.5 7.8 8 3.2l5.5 4.6v5.7a.8.8 0 0 1-.8.8H9.8v-3.4H6.2v3.4H3.3a.8.8 0 0 1-.8-.8z',
  'M2.5 3h11v10h-11zM2.5 6.4h11M2.5 9.7h11M6.3 6.4V13M9.7 6.4V13',
  'M5.5 5.5h5a2 2 0 0 1 2 2v3.5a1.5 1.5 0 0 1-1.5 1.5h-6A1.5 1.5 0 0 1 3.5 11V7.5a2 2 0 0 1 2-2zM6.5 3.2v2.1M9.5 3.2v2.1M6.2 9h.01M9.8 9h.01M6.6 12.5l-.8 1.6M9.4 12.5l.8 1.6',
  'M5.5 5.5h5v5h-5zM8 3v2.5M8 10.5V13M3 8h2.5M10.5 8H13',
  'M2.5 5.2a1 1 0 0 1 1-1h2.6l1.2 1.4h5.2a1 1 0 0 1 1 1v5.2a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1z',
  'M8 3.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9zM8 5.8V8l1.7 1.2',
  'M8 3.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9zM8 5v6M9.8 6.1c-.5-.7-3.3-.9-3.4.6-.1 1.6 3.3 1 3.2 2.7-.1 1.5-2.9 1.3-3.5.5',
  'M3 5.2c0-.7.5-1.2 1.2-1.2h7.6c.7 0 1.2.5 1.2 1.2M3 5.2v8.6c0 .7.5 1.2 1.2 1.2h7.6c.7 0 1.2-.5 1.2-1.2V5.2M3 8.4h10M8 5.2v9.8',
  'M8 6a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM8 2.8v1.4M8 11.8v1.4M2.8 8h1.4M11.8 8h1.4M4.3 4.3l1 1M10.7 10.7l1 1M11.7 4.3l-1 1M5.3 10.7l-1 1',
];
---

<div class="tapp-frame">
  <div class="tapp" style="--dw:1280">
    <!-- 标题栏 -->
    <div class="ta-ov-titlebar">
      <div class="ta-ov-lights"><i></i><i></i><i></i></div>
      <span class="ta-ov-wintitle">{t.windowTitle}</span>
    </div>

    <!-- 筛选栏 -->
    <div class="ta-ov-topbar">
      <span class="ta-filter">{t.topbarTimeRange}
        <span class="ta-combo">{t.rangeThisMonth}
          <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3.5 5 6.5 8 3.5"></path></svg>
        </span>
      </span>
      <span class="ta-filter">{t.topbarAgent}
        <span class="ta-combo" style="--w:150">{t.allAgents}
          <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3.5 5 6.5 8 3.5"></path></svg>
        </span>
      </span>
      <span class="ta-filter">{t.topbarModel}
        <span class="ta-combo">{t.allModels}
          <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3.5 5 6.5 8 3.5"></path></svg>
        </span>
      </span>
      <span class="ta-filter">{t.topbarProject}
        <span class="ta-combo">{t.allProjects}
          <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3.5 5 6.5 8 3.5"></path></svg>
        </span>
      </span>
      <span class="ta-topbar-right">
        <span class="ta-status">
          <span class="ta-dot"></span>
          {t.statusReady}
          <em>{t.lastUpdated} {o.updated[locale]}</em>
        </span>
        <span class="ta-sqbtn">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13.2 6.5A5.3 5.3 0 0 0 3.6 4.9M2.8 9.5a5.3 5.3 0 0 0 9.6 1.6M13.5 3v3.5H10M2.5 13V9.5H6"></path></svg>
        </span>
        <span class="ta-sqbtn">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="2.1"></circle><path d="M8 1.8v1.9M8 12.3v1.9M1.8 8h1.9M12.3 8h1.9M3.5 3.5l1.4 1.4M11.1 11.1l1.4 1.4M12.5 3.5l-1.4 1.4M4.9 11.1l-1.4 1.4"></path></svg>
        </span>
      </span>
    </div>

    <!-- 侧栏 + 主区 -->
    <div class="ta-ov-body">
      <aside class="ta-ov-side">
        <div class="ta-ov-brand">
          <svg width={30} height={30} viewBox="0 0 1024 1024" aria-hidden="true">
            <rect width="1024" height="1024" rx="239" fill="#14263f"></rect>
            <rect x="177" y="530" width="170" height="290" rx="85" fill="#1d9e79"></rect>
            <rect x="427" y="365" width="170" height="455" rx="85" fill="#27c496"></rect>
            <rect x="677" y="200" width="170" height="620" rx="85" fill="#38d6a4"></rect>
          </svg>
          <div>
            <div class="ta-ov-brand-name">Tokenmetry</div>
            <div class="ta-ov-brand-sub">ANALYTICS</div>
          </div>
        </div>
        <nav class="ta-nav">
          {t.nav.map((item, i) => (
            <span class={`item${i === 0 ? ' active' : ''}`}>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={navIcons[i]}></path></svg>
              {item}
            </span>
          ))}
        </nav>
      </aside>

      <div class="ta-ov-main">
        <h3 class="ta-ov-h1">{t.overviewTitle}</h3>
        <p class="ta-ov-sub">{t.overviewSubtitle}</p>

        <div class="ta-ov-kpis">
          <div class="ta-card ta-kpi">
            <div class="ta-kpi-top">
              <span class="ta-ic" style={`width:calc(34*var(--u));height:calc(34*var(--u))`}>
                <svg width={17} height={17} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="6.2" cy="6.2" r="3.9"></circle><circle cx="9.8" cy="9.8" r="3.9"></circle></svg>
              </span>
              {t.kpiTotalTokens}
            </div>
            <div class="ta-kpi-val">{total}</div>
            <div class="ta-kpi-foot"><span class="delta up">↑ {o.kpis.tokens.delta}</span>{t.kpiFootVsPrevious}</div>
          </div>
          <div class="ta-card ta-kpi">
            <div class="ta-kpi-top">
              <span class="ta-ic amber" style={`width:calc(34*var(--u));height:calc(34*var(--u))`}>
                <svg width={17} height={17} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M8 2.2v11.6M10.4 4.4c-.5-.8-4.3-1.2-4.5.8-.2 2.3 4.7 1.4 4.6 3.6-.1 2-4 1.8-4.8.8"></path></svg>
              </span>
              {t.kpiEstimatedCost}
            </div>
            <div class="ta-kpi-val">{o.kpis.cost.value}</div>
            <div class="ta-kpi-foot"><span class="delta up">↑ {o.kpis.cost.delta}</span>{t.kpiFootPriceEstimate}</div>
          </div>
          <div class="ta-card ta-kpi">
            <div class="ta-kpi-top">
              <span class="ta-ic purple" style={`width:calc(34*var(--u));height:calc(34*var(--u))`}>
                <svg width={17} height={17} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2.8" y="2.8" width="10.4" height="10.4" rx="1.4"></rect><path d="M2.8 6.1h10.4M2.8 9.9h10.4M6.1 6.1v7.1M9.9 6.1v7.1"></path></svg>
              </span>
              {t.kpiSessions}
            </div>
            <div class="ta-kpi-val">{o.kpis.sessions.value}</div>
            <div class="ta-kpi-foot"><span class="delta up">↑ {o.kpis.sessions.delta}</span>{t.kpiFootAcrossAgents}</div>
          </div>
          <div class="ta-card ta-kpi">
            <div class="ta-kpi-top">
              <span class="ta-ic green" style={`width:calc(34*var(--u));height:calc(34*var(--u))`}>
                <svg width={17} height={17} viewBox="0 0 16 16" fill="currentColor"><path d="M9.2 1.8 3.8 9h3l-.9 5.2L11.9 7h-3.1z"></path></svg>
              </span>
              {t.kpiCacheShare}
            </div>
            <div class="ta-kpi-val">{o.kpis.cache.value}</div>
            <div class="ta-kpi-foot"><span class="delta down">↓ {o.kpis.cache.delta}</span>{t.kpiFootCacheOfInput}</div>
          </div>
        </div>

        <div class="ta-ov-row">
          <div class="ta-card ta-panel">
            <div class="ta-trend-head">
              <div class="l">
                <span class="ta-card-title">{t.panelTrend}</span>
                <span class="ta-card-meta">{t.legendDaily}</span>
              </div>
              <div class="ta-legend">
                <span class="ta-dot" style="background:var(--tablue)"></span><b>{t.legendInput}</b>
                <span class="ta-dot" style="background:var(--tapurple)"></span><b>{t.legendOutput}</b>
                <span class="ta-dot" style="background:var(--tacyan)"></span><b>{t.legendTotal}</b>
              </div>
            </div>
            <svg class="ta-trend-chart" viewBox={`0 0 ${W} 330`} role="img" aria-label={t.panelTrend}>
              {[100, 200, 300, 400].map((v) => (
                <line x1={L} x2={W - R} y1={yAt(v)} y2={yAt(v)} stroke="var(--tagrid)" stroke-width="1"></line>
              ))}
              <line x1={L} x2={W - R} y1={BOTTOM} y2={BOTTOM} stroke="var(--taaxis)" stroke-width="1"></line>
              {o.trendYLabels.map((label, i) => (
                <text x={L - 8} y={yAt(i * 100) + 3.5} text-anchor="end" font-size="11" fill="var(--tamuted)">{label}</text>
              ))}
              {o.trendM.map((v, i) => {
                /* 基线迷你柱：与原截图同构——总量缩放的矮柱，紫(输出)段叠在蓝(输入)段上，峰值仅约 4.5px */
                const total = Math.max(1.2, v * 0.0105);
                const hOut = total * 0.62;
                const hIn = total - hOut;
                return (
                  <g>
                    <rect x={xAt(i) - 7} y={BOTTOM - hIn} width="14" height={hIn} rx="1" fill="var(--tablue)" opacity="0.5"></rect>
                    <rect x={xAt(i) - 7} y={BOTTOM - total} width="14" height={hOut} rx="1" fill="var(--tapurple)" opacity="0.9"></rect>
                  </g>
                );
              })}
              <path d={linePath} fill="none" stroke="var(--tacyan)" stroke-width="2.2" stroke-linejoin="round"></path>
              {pts.map(([x, y]) => <circle cx={x} cy={y} r="2.7" fill="var(--tacyan)"></circle>)}
              {o.trendXLabels.map((label, i) => (
                <text x={xAt(i * 3)} y={BOTTOM + 20} text-anchor={i === 0 ? 'start' : i === 8 ? 'end' : 'middle'} font-size="11" fill="var(--tamuted)">{label}</text>
              ))}
            </svg>
          </div>

          <div class="ta-card ta-panel ta-donut-card">
            <div class="ta-card-head">
              <span class="ta-card-title">{t.panelAgentDonut}</span>
              <span class="ta-card-meta">{t.metaByTotalTokens}</span>
            </div>
            <div class="ta-donut-body">
              <div class="ta-donut">
                <svg viewBox="0 0 120 120">
                  {agentSegs.map((s) => (
                    <circle cx="60" cy="60" r="50" fill="none" stroke={s.color} stroke-width="16" stroke-dasharray={`${s.dash} ${C - s.dash}`} stroke-dashoffset={s.offset} transform="rotate(-90 60 60)"></circle>
                  ))}
                </svg>
                <div class="ta-donut-center"><b>{total}</b><span>{t.totalTokens}</span></div>
              </div>
              <div class="ta-donut-legend">
                {o.agentDonut.segments.map((s) => (
                  <div class="row">
                    <span class="ta-dot" style={`background:${s.color}`}></span>
                    <span>{s.name}</span>
                    <b>{s.share}%</b>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="ta-ov-row equal">
          <div class="ta-card ta-panel">
            <div class="ta-card-head">
              <span class="ta-card-title">{t.panelModelDistribution}</span>
              <span class="ta-card-meta" style="color:var(--talink);font-weight:600">{t.viewDetails}</span>
            </div>
            <div class="ta-mdl-head">
              <span>{t.thModel}</span>
              <span class="r">{t.thTokenCount}</span>
              <span class="r">{t.thShare}</span>
            </div>
            {o.models.map((m) => (
              <div class="ta-mdl-row">
                <div class="ta-mdl-line">
                  <span class="ta-mdl-name"><Mark kind={m.logo} size={18} /><span>{m.name}</span></span>
                  <span class="ta-mdl-val">{m.tokens}</span>
                  <span class="ta-mdl-val">{m.share}</span>
                </div>
                <div class="ta-mini ta-mdl-track"><i style={`width:${parseFloat(m.share) < 1 ? 0.8 : parseFloat(m.share)}%`}></i></div>
              </div>
            ))}
          </div>

          <div class="ta-card ta-panel ta-donut-card">
            <div class="ta-card-head">
              <span class="ta-card-title">{t.panelTypeDonut}</span>
              <span class="ta-card-meta">{t.metaNormalizedAcrossSources}</span>
            </div>
            <div class="ta-donut-body">
              <div class="ta-donut">
                <svg viewBox="0 0 120 120">
                  {typeSegs.map((s) => (
                    <circle cx="60" cy="60" r="50" fill="none" stroke={s.color} stroke-width="16" stroke-dasharray={`${s.dash} ${C - s.dash}`} stroke-dashoffset={s.offset} transform="rotate(-90 60 60)"></circle>
                  ))}
                </svg>
                <div class="ta-donut-center"><b>{total}</b><span>{t.totalTokens}</span></div>
              </div>
              <div class="ta-donut-legend">
                {[
                  { label: t.tokenTypeInput, share: '2.8%', color: '#4c8dff' },
                  { label: t.tokenTypeOutput, share: '0.6%', color: '#a779ff' },
                  { label: t.tokenTypeCache, share: '96.6%', color: '#38d6a4' },
                ].map((row) => (
                  <div class="row">
                    <span class="ta-dot" style={`background:${row.color}`}></span>
                    <span>{row.label}</span>
                    <b>{row.share}</b>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
