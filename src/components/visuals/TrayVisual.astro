---
import { ui, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale].app;

const agents = [
  { name: 'Claude Code', state: t.trayCurrent, rate: '8.2K/min', w: 49, tokens: '20,624', pct: '48.7%', live: true },
  { name: 'Codex', state: t.trayRecent, rate: '3.1K/min', w: 32, tokens: '13,582', pct: '32.1%', live: false },
  { name: 'Gemini CLI', state: t.trayRecent, rate: '1.4K/min', w: 12, tokens: '5,261', pct: '12.4%', live: false },
  { name: 'ZCode', state: t.trayRecent, rate: '0.6K/min', w: 7, tokens: '2,914', pct: '6.8%', live: false },
];
const metrics = [
  { label: t.trayIn, v: '26,843', pct: '63.3%', c: 'var(--series-0)' },
  { label: t.trayOut, v: '13,124', pct: '31.0%', c: 'var(--series-3)' },
  { label: t.trayCacheShort, v: '2,414', pct: '5.7%', c: 'var(--series-1)' },
];
---

<div class="tray-wrap" aria-hidden="true">
  <div class="popup">
    <div class="head">
      <span class="logo">T</span>
      <span class="brand">Tokenmetry</span>
      <span class="live"><i></i>{t.trayLive}</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="3.2"></circle>
        <path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5.5 5.5l1.7 1.7M16.8 16.8l1.7 1.7M18.5 5.5l-1.7 1.7M7.2 16.8l-1.7 1.7"></path>
      </svg>
    </div>
    <div class="body">
      <div class="stats">
        <div>
          <div class="lab">{t.trayToday}</div>
          <div class="num-v">42,381</div>
          <div class="cap">{t.trayAllAgents}</div>
        </div>
        <div class="small">
          <div class="lab">{t.trayCost}</div>
          <div class="num-v">$12.46</div>
          <div class="cap">USD</div>
        </div>
        <div class="small">
          <div class="lab">{t.trayCache}</div>
          <div class="num-v">68%</div>
          <div class="cap">cache read</div>
        </div>
      </div>
      <div class="bar">
        <b style="width:63.3%;background:var(--series-0)"></b>
        <b style="width:31%;background:var(--series-3)"></b>
        <b style="width:5.7%;background:var(--series-1)"></b>
      </div>
      <div class="metrics">
        {metrics.map((m) => (
          <div class="metric">
            <div class="mt"><i class="dot" style={`background:${m.c}`}></i>{m.label}</div>
            <div class="mv num">{m.v}</div>
            <div class="mp num">{m.pct}</div>
          </div>
        ))}
      </div>
      <div class="hr"></div>
      <div class="sect"><strong>{t.trayTopAgents}</strong></div>
      {agents.map((a) => (
        <div class="agent">
          <span class={`ai ${a.live ? 'live-bg' : ''}`}>{a.name.charAt(0)}</span>
          <div class="mid">
            <div class="an">{a.name}</div>
            <div class="as num">{a.state} · {a.rate}</div>
            <div class="track"><i style={`width:${a.w}%`}></i></div>
          </div>
          <div class="ar num">{a.tokens}<small>{a.pct}</small></div>
        </div>
      ))}
      <div class="hr"></div>
      <div class="foot">
        <span class="fbtn">{t.traySession} · 8.4K</span>
        <span class="fbtn primary">{t.trayOpen}</span>
      </div>
    </div>
  </div>
  <div class="tray">
    <span class="tlogo">T</span>
    <span class="tv num">42.4K · $12.46</span>
    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
      <path d="m6 14 6-6 6 6"></path>
    </svg>
  </div>
</div>

<style>
  .tray-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    padding: 14px 0 6px;
  }

  .popup {
    width: min(430px, 100%);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 15px;
    box-shadow: 0 22px 70px rgba(2, 8, 20, 0.35);
    overflow: hidden;
  }

  [data-theme='light'] .popup {
    box-shadow: 0 18px 48px rgba(30, 50, 90, 0.16);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 12px 15px;
    border-bottom: 1px solid var(--line-soft);
  }

  .head svg {
    margin-left: auto;
    color: var(--muted);
  }

  .logo,
  .tlogo {
    display: inline-grid;
    place-items: center;
    width: 25px;
    height: 25px;
    border-radius: 8px;
    background: linear-gradient(140deg, #3986ed, #8a68e9);
    color: #fff;
    font-weight: 800;
    font-size: 13px;
  }

  .tlogo {
    width: 21px;
    height: 21px;
    font-size: 11px;
    border-radius: 7px;
  }

  .brand {
    font-weight: 700;
    font-size: 13.5px;
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    color: var(--green);
  }

  .live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px var(--green);
  }

  .body {
    padding: 14px 15px 15px;
  }

  .stats {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 12px;
  }

  .lab {
    font-size: 10px;
    color: var(--muted);
  }

  .num-v {
    font-size: 20px;
    font-weight: 750;
    letter-spacing: -0.02em;
    margin-top: 3px;
    font-variant-numeric: tabular-nums;
  }

  .small .num-v {
    font-size: 16px;
  }

  .cap {
    font-size: 9px;
    color: var(--muted);
    margin-top: 2px;
  }

  .bar {
    display: flex;
    height: 9px;
    margin: 13px 0 9px;
    background: var(--panel-2);
    border: 1px solid var(--line-soft);
    border-radius: 5px;
    overflow: hidden;
  }

  .bar b {
    height: 100%;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 7px;
  }

  .metric {
    background: var(--panel-2);
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    padding: 8px 9px;
  }

  .mt {
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--muted);
    font-size: 10px;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .mv {
    font-size: 12.5px;
    font-weight: 650;
    margin-top: 4px;
  }

  .mp {
    font-size: 9px;
    color: var(--muted);
  }

  .hr {
    height: 1px;
    background: var(--line-soft);
    margin: 13px 0;
  }

  .sect {
    display: flex;
    align-items: center;
    margin-bottom: 5px;
  }

  .sect strong {
    font-size: 11px;
  }

  .agent {
    display: grid;
    grid-template-columns: 24px 1fr auto;
    gap: 9px;
    align-items: center;
    padding: 6px 0;
  }

  .ai {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: var(--panel-2);
    border: 1px solid var(--line-soft);
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
  }

  .ai.live-bg {
    background: var(--chip-bg);
    color: var(--link);
  }

  .an {
    font-size: 11.5px;
    font-weight: 600;
  }

  .as {
    font-size: 9.5px;
    color: var(--muted);
    margin-top: 1px;
  }

  .track {
    height: 3px;
    background: var(--panel-2);
    border-radius: 3px;
    margin-top: 5px;
    overflow: hidden;
  }

  .track i {
    display: block;
    height: 100%;
    background: var(--series-0);
    border-radius: 3px;
  }

  .ar {
    text-align: right;
    font-size: 11.5px;
    font-weight: 600;
  }

  .ar small {
    display: block;
    color: var(--muted);
    font-size: 9px;
    font-weight: 400;
    margin-top: 1px;
  }

  .foot {
    display: flex;
    gap: 7px;
  }

  .fbtn {
    flex: 1;
    text-align: center;
    border-radius: 8px;
    padding: 8px;
    border: 1px solid var(--line);
    background: var(--panel-2);
    color: var(--text);
    font-size: 10.5px;
    font-weight: 550;
  }

  .fbtn.primary {
    background: linear-gradient(90deg, var(--btn-primary-a), var(--btn-primary-b));
    border-color: transparent;
    color: #fff;
    font-weight: 650;
  }

  .tray {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 13px 0 8px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--panel) 88%, transparent);
    backdrop-filter: blur(8px);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(2, 8, 20, 0.3);
  }

  .tv {
    font-size: 11.5px;
    font-weight: 600;
  }

  .tray svg {
    color: var(--muted);
  }
</style>
