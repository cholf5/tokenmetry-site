---
/**
 * 托盘快捷信息窗复刻（原 tray-*.png，420×546 裁剪位）：今日三 KPI + 构成条/三卡 +
 * 主要 Agent 行 + 双按钮。
 */
import { ui, type Locale } from '../../i18n/ui';
import { tray, fmtCompact, fmtCost, fmtN0 } from '../../data/app-demo';
import Mark from './Mark.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale].app;

const segLabels = [t.legendInput, t.legendOutput, t.popoverSegCache];
---

<div class="tapp-frame">
  <div class="tapp" style="--dw:420">
    <div class="ta-tray">
      <div class="ta-tray-head">
        <svg width={20} height={20} viewBox="0 0 1024 1024" aria-hidden="true">
          <rect width="1024" height="1024" rx="239" fill="#14263f"></rect>
          <rect x="177" y="530" width="170" height="290" rx="85" fill="#1d9e79"></rect>
          <rect x="427" y="365" width="170" height="455" rx="85" fill="#27c496"></rect>
          <rect x="677" y="200" width="170" height="620" rx="85" fill="#38d6a4"></rect>
        </svg>
        <span class="name">Tokenmetry</span>
        <span class="live"><span class="ta-dot"></span>{t.popoverLive}</span>
        <span class="gear">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="2.1"></circle><path d="M8 1.8v1.9M8 12.3v1.9M1.8 8h1.9M12.3 8h1.9M3.5 3.5l1.4 1.4M11.1 11.1l1.4 1.4M12.5 3.5l-1.4 1.4M4.9 11.1l-1.4 1.4"></path></svg>
        </span>
      </div>

      <div class="ta-tray-kpis">
        <div>
          <div class="lbl">{t.popoverTodayTokens}</div>
          <div class="val">{fmtCompact(tray.tokens, locale)}</div>
          <div class="foot">{t.popoverTodayTokensCap}</div>
        </div>
        <div>
          <div class="lbl">{t.kpiEstimatedCost}</div>
          <div class="val">{fmtCost(tray.knownCost, tray.hasUnknownCost)}</div>
          <div class="foot">{t.metaEstimateUsd}</div>
        </div>
        <div>
          <div class="lbl">{t.popoverCacheHit}</div>
          <div class="val">79.0%</div>
          <div class="foot">{t.popoverCacheCaption}</div>
        </div>
      </div>

      <div class="ta-tray-bar">
        {tray.segs.map((s) => <i style={`width:${s.pct};background:${s.color}`}></i>)}
      </div>

      <div class="ta-tray-segs">
        {tray.segs.map((s, i) => (
          <div class="ta-tray-seg">
            <div class="l"><span class="ta-dot" style={`background:${s.color}`}></span>{segLabels[i]}</div>
            <div class="v">{fmtN0(s.full)}</div>
            <div class="p">{s.pct}</div>
          </div>
        ))}
      </div>

      <div class="ta-tray-top">
        <span class="t">{t.popoverTopAgents}</span>
        <span class="a">{t.viewDetails}</span>
      </div>

      <div class="ta-tray-agents">
        {tray.agents.map((a) => (
          <div class="ta-tray-agent">
            <div class="line">
              <Mark kind={a.logo} size={16} />
              <span>{a.key}</span>
              <span class="v">{fmtCompact(a.tokens, locale)} / {a.cost === null ? t.unknown : fmtCost(a.cost)}</span>
            </div>
            <div class="ta-mini"><i style={`width:${a.bar * 100}%`}></i></div>
          </div>
        ))}
      </div>

      <div class="ta-tray-actions">
        <span class="ta-tray-btn">{t.popoverRecentSessions}</span>
        <span class="ta-tray-btn primary">{t.popoverOpenStats}</span>
      </div>
    </div>
  </div>
</div>
