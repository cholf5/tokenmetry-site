---
import { ui, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale].app;

// 小时分布：与原型同源的 24 点样例（本地时间，工作时段高、夜间低）
const hours = [0.12, 0.08, 0.04, 0.02, 0.03, 0.1, 0.25, 0.45, 0.6, 0.8, 0.95, 0.7, 0.8, 0.92, 0.72, 0.6, 0.7, 0.85, 0.9, 0.68, 0.5, 0.42, 0.3, 0.2];
const max = Math.max(...hours);
// 活跃日历：35 格（5 周）
const days = Array.from({ length: 35 }, (_, i) => Math.abs(Math.sin(i * 1.7)));

const W = 560, H = 150, L = 26, R = 8, T = 8, B = 22;
const pw = W - L - R, ph = H - T - B;
const bw = (pw / hours.length) * 0.62;
const kpis = [
  { v: '14:00–15:00', foot: locale === 'zh' ? '占入桶 Token 9.4%' : '9.4% of bucketed tokens' },
  { v: locale === 'zh' ? '周三' : 'Wed', foot: locale === 'zh' ? '当日 1.28M tokens' : '1.28M tokens that day' },
  { v: '412K', foot: locale === 'zh' ? '按 28 个活跃日平均' : 'averaged over 28 active days' },
  { v: '28', foot: locale === 'zh' ? '窗口共 30 天' : 'of a 30-day window' },
];
const kpiTitles = [t.peakHour, t.peakDay, t.dailyAvg, t.activeDays];
---

<div class="appwin" aria-hidden="true">
  <div class="aw-top">
    <span class="aw-dots"><i></i><i></i><i></i></span>
    <span class="aw-title">{t.pageTime}</span>
    <span class="aw-pill">{locale === 'zh' ? '最近 30 天 · 所有 Agent' : 'Last 30 days · All agents'}</span>
  </div>
  <div class="aw-body">
    <div class="kpi-row">
      {kpis.map((k, i) => (
        <div class="kpi">
          <div class="kpi-top">{kpiTitles[i]}</div>
          <div class="kpi-value">{k.v}</div>
          <div class="kpi-foot">{k.foot}</div>
        </div>
      ))}
    </div>
    <div class="app-grid2">
      <div class="app-panel">
        <div class="app-panelhead">
          <strong>{t.hourly}</strong>
          <span class="meta">{t.hourlyMeta}</span>
        </div>
        <svg class="app-chart" viewBox={`0 0 ${W} ${H}`} role="img">
          {[0, 1, 2, 3].map((i) => {
            const y = T + (ph * i) / 3;
            return <line class="gridline" x1={L} y1={y} x2={W - R} y2={y} />;
          })}
          {hours.map((v, i) => {
            const x = L + (pw * (i + 0.5)) / hours.length;
            const h = (v / max) * ph;
            return (
              <rect
                x={x - bw / 2}
                y={T + ph - h}
                width={bw}
                height={h}
                rx="1.5"
                fill={i === 14 ? 'var(--series-0)' : 'color-mix(in srgb, var(--series-0) 72%, var(--panel-2))'}
              />
            );
          })}
          {hours.map((_, i) =>
            i % 3 === 0 ? (
              <text x={L + (pw * (i + 0.5)) / hours.length} y={H - 6} text-anchor="middle">
                {String(i).padStart(2, '0')}
              </text>
            ) : null,
          )}
        </svg>
      </div>
      <div class="app-panel">
        <div class="app-panelhead">
          <strong>{t.calendar}</strong>
          <span class="meta">{t.calendarMeta}</span>
        </div>
        <div class="heatmap">
          {days.map((v) => (
            <i style={`background: color-mix(in srgb, var(--series-0) ${Math.round(14 + v * 84)}%, var(--panel-2))`}></i>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
