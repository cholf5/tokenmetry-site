---
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
---

<section id="how">
  <div class="container">
    <div class="section-head">
      <h2>{t.how.title}</h2>
    </div>
    <ol class="steps">
      {t.how.steps.map((s, i) => (
        <li>
          <span class="no num" aria-hidden="true">0{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    counter-reset: step;
  }

  li {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 26px 24px;
  }

  .no {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: var(--link);
    letter-spacing: 0.08em;
    margin-bottom: 14px;
  }

  h3 {
    font-size: 17px;
    font-weight: 650;
    margin-bottom: 8px;
  }

  p {
    font-size: 14.5px;
    color: var(--muted);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
