---
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const fiveDots = [0, 1, 2, 3, 4].map((i) => `var(--series-${i})`);
---

<section id="recon" class="full-bleed">
  <div class="container">
    <div class="head">
      <span class="kicker">{t.recon.kicker}</span>
      <h2>{t.recon.title}</h2>
    </div>

    <div class="ledger">
      <div class="big-side">
        <div class="big mono num">{t.recon.big}</div>
        <p class="note">{t.recon.bigNote}</p>
        <p class="cli mono">vs <code>{t.recon.cli}</code> · {t.recon.dayByDay}</p>
      </div>
      <div class="facts-side">
        <p class="five-title">{t.recon.fiveTitle}</p>
        <ul class="five">
          {t.recon.five.map((f, i) => (
            <li>
              <span class="dot" style={`--dot:${fiveDots[i]}`}></span>
              <span class="mono k">{f.key}</span>
              <span class="lab">{f.label}</span>
            </li>
          ))}
        </ul>
        <p class="offline">{t.recon.offlineNote}</p>
      </div>
    </div>

    <div class="pipeline mono" aria-label={t.recon.pipelineTitle}>
      <span class="pl-title">{t.recon.pipelineTitle}</span>
      {t.recon.pipeline.map((step, i) => (
        <span class="pl-step num">
          {i > 0 && <span class="arrow">→</span>}
          {step}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    padding: 72px 0;
  }

  .head {
    max-width: 640px;
    margin-bottom: 38px;
  }

  .head h2 {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .ledger {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 40px;
    align-items: start;
  }

  .big {
    font-size: clamp(44px, 7vw, 72px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    background: linear-gradient(100deg, var(--series-0), var(--series-4));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* 浅色底上青色端失去对比，换浅色 accent → 紫（产品浅色令牌原值） */
  [data-theme='light'] .big {
    background: linear-gradient(100deg, var(--accent), var(--purple));
  }

  .note {
    margin-top: 14px;
    color: var(--muted);
    font-size: 14.5px;
    max-width: 480px;
  }

  .cli {
    margin-top: 10px;
    font-size: 13px;
    color: var(--muted);
  }

  .cli code {
    color: var(--link);
    font-size: 13px;
  }

  .facts-side {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel);
    padding: 20px 22px;
  }

  .five-title {
    font-size: 14px;
    font-weight: 650;
    margin-bottom: 14px;
  }

  .five {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .five li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
  }

  .five .k {
    color: var(--text);
    min-width: 150px;
  }

  .five .lab {
    color: var(--muted);
  }

  .offline {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
    color: var(--muted);
    font-size: 12.5px;
  }

  .pipeline {
    margin-top: 44px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 6px;
    font-size: 13px;
    color: var(--muted);
  }

  .pl-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-right: 10px;
    color: var(--text);
  }

  .pl-step {
    border: 1px solid var(--line);
    background: var(--panel);
    border-radius: 8px;
    padding: 6px 12px;
    color: var(--text);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .arrow {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .ledger {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .head h2 {
      font-size: 25px;
    }
  }
</style>
