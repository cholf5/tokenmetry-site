---
import { ui, type Locale } from '../i18n/ui';
import TimeVisual from './visuals/TimeVisual.astro';
import CostVisual from './visuals/CostVisual.astro';
import PricingVisual from './visuals/PricingVisual.astro';
import TrayVisual from './visuals/TrayVisual.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const icons: Record<string, string> = {
  sources: 'M4 6h16M4 12h16M4 18h10',
  views: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
  time: 'M12 7v5l3.5 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  cost: 'M12 3v18M16.5 7.5c-.9-1.4-2.5-2-4.5-2-2.5 0-4 1.2-4 3s1.5 2.6 4 3.2c2.7.6 4.5 1.4 4.5 3.3s-1.7 3-4.5 3c-2.2 0-3.9-.8-4.7-2.4',
  pricing: 'M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3ZM4 7v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3',
  tray: 'M4 15h16M7 15v-3a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v3M6 15l-1.5 4h3L10 18l2.5 1L15 19h3L16.5 15M13 6.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM12 3v1.5',
};
const iconKeys = ['sources', 'views', 'time', 'cost', 'pricing', 'tray'];
---

<section id="features">
  <div class="container">
    <div class="section-head">
      <h2>{t.features.title}</h2>
      <p class="sub">{t.features.subtitle}</p>
    </div>
    <div class="grid">
      {t.features.items.map((item, i) => (
        <article class:list={['card', { 'has-visual': !!item.visual }]}>
          <div class="head">
            <span class="ico" aria-hidden="true">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={icons[iconKeys[i]]} />
              </svg>
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </div>
          {item.visual === 'time' && <div class="visual"><TimeVisual locale={locale} /></div>}
          {item.visual === 'cost' && <div class="visual"><CostVisual locale={locale} /></div>}
          {item.visual === 'pricing' && <div class="visual"><PricingVisual locale={locale} /></div>}
          {item.visual === 'tray' && <div class="visual tray"><TrayVisual locale={locale} /></div>}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 24px;
  }

  .head {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .ico {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    color: var(--link);
    background: var(--chip-bg);
    flex: 0 0 auto;
  }

  h3 {
    font-size: 16px;
    font-weight: 650;
    margin-bottom: 6px;
  }

  .head p {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
  }

  .visual {
    margin-top: 18px;
  }

  .visual.tray {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
