---
import { Image } from 'astro:assets';
import { ui, type Locale } from '../i18n/ui';
import timeZhDark from '../assets/shots/time-zh-dark.png';
import timeZhLight from '../assets/shots/time-zh-light.png';
import timeEnDark from '../assets/shots/time-en-dark.png';
import timeEnLight from '../assets/shots/time-en-light.png';
import costZhDark from '../assets/shots/cost-zh-dark.png';
import costZhLight from '../assets/shots/cost-zh-light.png';
import costEnDark from '../assets/shots/cost-en-dark.png';
import costEnLight from '../assets/shots/cost-en-light.png';
import pricingZhDark from '../assets/shots/data-pricing-zh-dark.png';
import pricingZhLight from '../assets/shots/data-pricing-zh-light.png';
import pricingEnDark from '../assets/shots/data-pricing-en-dark.png';
import pricingEnLight from '../assets/shots/data-pricing-en-light.png';
import trayZhDark from '../assets/shots/tray-zh-dark.png';
import trayZhLight from '../assets/shots/tray-zh-light.png';
import trayEnDark from '../assets/shots/tray-en-dark.png';
import trayEnLight from '../assets/shots/tray-en-light.png';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];

const shots: Record<string, { dark: ImageMetadata; light: ImageMetadata; alt: string; altEn: string; tray?: boolean }> = {
  time: {
    dark: locale === 'zh' ? timeZhDark : timeEnDark,
    light: locale === 'zh' ? timeZhLight : timeEnLight,
    alt: 'Tokenmetry 时间分析视图：高峰时段 KPI、按小时分布图与活跃日历热力图',
    altEn: 'Tokenmetry time analysis: peak-hour KPIs, hourly distribution chart and activity calendar heatmap',
  },
  cost: {
    dark: locale === 'zh' ? costZhDark : costEnDark,
    light: locale === 'zh' ? costZhLight : costEnLight,
    alt: 'Tokenmetry 成本分析视图：估算总成本 KPI 与成本计算口径表',
    altEn: 'Tokenmetry cost analysis: estimated-cost KPIs and the cost methodology table',
  },
  pricing: {
    dark: locale === 'zh' ? pricingZhDark : pricingEnDark,
    light: locale === 'zh' ? pricingZhLight : pricingEnLight,
    alt: 'Tokenmetry 数据与计价视图：数据源状态表与模型目录',
    altEn: 'Tokenmetry data & pricing: source status table and the model catalog',
  },
  tray: {
    dark: locale === 'zh' ? trayZhDark : trayEnDark,
    light: locale === 'zh' ? trayZhLight : trayEnLight,
    alt: 'Tokenmetry 托盘快捷信息窗：今日 Token、估算成本、构成占比与主要 Agent',
    altEn: 'Tokenmetry tray popover: tokens today, estimated cost, composition and top agents',
    tray: true,
  },
};

const icons: Record<string, string> = {
  sources: 'M4 6h16M4 12h16M4 18h10',
  views: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
  time: 'M12 7v5l3.5 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  cost: 'M12 3v18M16.5 7.5c-.9-1.4-2.5-2-4.5-2-2.5 0-4 1.2-4 3s1.5 2.6 4 3.2c2.7.6 4.5 1.4 4.5 3.3s-1.7 3-4.5 3c-2.2 0-3.9-.8-4.7-2.4',
  pricing: 'M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3ZM4 7v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3',
  tray: 'M4 15h16M7 15v-3a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v3M6 15l-1.5 4h3L10 18l2.5 1L15 19h3L16.5 15M13 6.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM12 3v1.5',
};
const iconKeys = ['sources', 'views', 'time', 'cost', 'pricing', 'tray'];
---

<section id="features">
  <div class="container">
    <div class="section-head">
      <h2>{t.features.title}</h2>
      <p class="sub">{t.features.subtitle}</p>
    </div>
    <div class="grid">
      {t.features.items.map((item, i) => (
        <article class:list={['card', { 'has-visual': !!item.visual }]}>
          <div class="head">
            <span class="ico" aria-hidden="true">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={icons[iconKeys[i]]} />
              </svg>
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </div>
          {item.visual && (
            <div class:list={['visual', 'theme-dual', { tray: shots[item.visual].tray }]}>
              <Image
                src={shots[item.visual].dark}
                alt={locale === 'zh' ? shots[item.visual].alt : shots[item.visual].altEn}
                widths={shots[item.visual].tray ? [498] : [640, 1024]}
                sizes={shots[item.visual].tray ? '(max-width: 640px) 86vw, 330px' : '(max-width: 900px) 100vw, 504px'}
                format="webp"
                class="t-dark"
                loading="lazy"
              />
              <Image
                src={shots[item.visual].light}
                alt=""
                aria-hidden="true"
                widths={shots[item.visual].tray ? [498] : [640, 1024]}
                sizes={shots[item.visual].tray ? '(max-width: 640px) 86vw, 330px' : '(max-width: 900px) 100vw, 504px'}
                format="webp"
                class="t-light"
                loading="lazy"
              />
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 24px;
  }

  .head {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .ico {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    color: var(--link);
    background: var(--chip-bg);
    flex: 0 0 auto;
  }

  h3 {
    font-size: 16px;
    font-weight: 650;
    margin-bottom: 6px;
  }

  .head p {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
  }

  .visual {
    margin-top: 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }

  .visual.tray {
    border: 0;
    background: transparent;
    overflow: visible;
    display: flex;
    justify-content: center;
    filter: drop-shadow(0 16px 40px rgba(2, 8, 20, 0.3));
  }

  [data-theme='light'] .visual.tray {
    filter: drop-shadow(0 14px 34px rgba(30, 50, 90, 0.16));
  }

  .visual.tray img {
    max-width: 330px;
    border-radius: 14px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
