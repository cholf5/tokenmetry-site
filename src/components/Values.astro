---
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const icons = [
  // ledger
  'M4 5h16v14H4zM4 9h16M9 9v10',
  // verify / check-shield
  'M12 3 5 6v5c0 4.4 3 8.4 7 9.5 4-1.1 7-5.1 7-9.5V6l-7-3ZM9 11.5l2.2 2.2L15.5 9',
  // device / local
  'M4 5h16v10H4zM9 19h6M12 15v4',
];
---

<section id="why">
  <div class="container">
    <div class="section-head">
      <h2>{t.values.title}</h2>
    </div>
    <div class="grid">
      {t.values.items.map((item, i) => (
        <article class="card">
          <span class="ico" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d={icons[i]} />
            </svg>
          </span>
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 26px 24px;
  }

  .ico {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    color: var(--link);
    background: var(--chip-bg);
    margin-bottom: 16px;
  }

  h3 {
    font-size: 17px;
    font-weight: 650;
    margin-bottom: 8px;
  }

  p {
    font-size: 14.5px;
    color: var(--muted);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
