---
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const accents = ['var(--series-1)', 'var(--series-4)', 'var(--series-0)', 'var(--series-2)'];
---

<section id="local">
  <div class="container inner">
    <div class="head">
      <span class="kicker">{t.local.kicker}</span>
      <h2>{t.local.title}</h2>
      <ul class="stances">
        {t.local.stances.map((s, i) => (
          <li style={`--acc:${accents[i]}`}>
            <strong>{s.title}</strong>
            <span>{s.desc}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="panel">
      <p class="p-title">{t.local.pathsTitle}</p>
      {t.local.paths.map((p) => (
        <div class="path">
          <span class="label">{p.label}</span>
          <code class="mono">{p.value}</code>
        </div>
      ))}
      <p class="privacy">{t.local.privacy}</p>
      <p class="honesty mono">{t.local.honesty}</p>
    </div>
  </div>
</section>

<style>
  .inner {
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: 48px;
    align-items: start;
  }

  h2 {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .stances {
    list-style: none;
    margin: 30px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .stances li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 16px;
    border-left: 2px solid var(--acc);
  }

  .stances strong {
    font-size: 16.5px;
    font-weight: 700;
  }

  .stances span {
    color: var(--muted);
    font-size: 14px;
  }

  .panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 22px;
  }

  .p-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .path {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px dashed var(--line);
  }

  .path:last-of-type {
    border-bottom: 0;
  }

  .label {
    flex: 0 0 110px;
    font-size: 12.5px;
    color: var(--muted);
  }

  .path code {
    font-size: 13px;
    color: var(--link);
    word-break: break-all;
  }

  .privacy {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 13.5px;
  }

  .honesty {
    margin-top: 12px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>
