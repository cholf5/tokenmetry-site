---
import { site } from '../config/site';
import { ui, LANGUAGES, localePath, type Locale } from '../i18n/ui';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const self = LANGUAGES.find((l) => l.id === locale)!;
const home = localePath(locale) || '/';
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={home} aria-label="Tokenmetry">
      <Logo size={26}></Logo>
      <span>Tokenmetry</span>
    </a>

    <nav class="links" aria-label={t.nav.ariaMain}>
      <a href="#views">{t.nav.views}</a>
      <a href="#recon">{t.nav.recon}</a>
      <a href="#sources">{t.nav.sources}</a>
    </nav>

    <div class="actions">
      <details class="lang" data-lang-menu>
        <summary aria-label={t.nav.langAria}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18M12 3a14.5 14.5 0 0 1 0 18M12 3a14.5 14.5 0 0 0 0 18"></path>
          </svg>
          <span class="lang-full">{self.nativeName}</span>
          <span class="lang-short">{self.short}</span>
        </summary>
        <ul class="lang-menu">
          {LANGUAGES.map((l) => (
            <li>
              <a
                href={l.path || '/'}
                data-lang-link={l.id}
                hreflang={l.tag}
                aria-current={l.id === locale ? 'true' : undefined}
              >
                {l.nativeName}
              </a>
            </li>
          ))}
        </ul>
      </details>
      <button
        class="icon-link"
        type="button"
        data-theme-toggle
        aria-label={t.nav.themeAria}
      >
        <svg class="ico-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5 5l1.7 1.7M17.3 17.3 19 19M19 5l-1.7 1.7M6.7 17.3 5 19"></path>
        </svg>
        <svg class="ico-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.6 14.2A8.8 8.8 0 0 1 9.8 3.4a8.8 8.8 0 1 0 10.8 10.8Z"></path>
        </svg>
      </button>
      <a class="btn btn-primary btn-dl" href={site.releases} target="_blank" rel="noopener">{t.nav.download}</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line-soft);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 62px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .brand:hover {
    text-decoration: none;
  }

  .links {
    display: flex;
    gap: 26px;
    margin-left: 14px;
    font-size: 14.5px;
  }

  .links a {
    color: var(--muted);
    font-weight: 500;
  }

  .links a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 10px;
    border-radius: 9px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background-color 0.15s;
  }

  .icon-link:hover {
    color: var(--text);
    background: var(--panel-2);
    text-decoration: none;
  }

  /* 语言切换：details/summary 纯 HTML 开合，外观对齐 icon-link */
  .lang {
    position: relative;
  }

  .lang summary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 36px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: 9px;
    color: var(--muted);
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color 0.15s, border-color 0.15s, background-color 0.15s;
  }

  .lang summary::-webkit-details-marker {
    display: none;
  }

  .lang summary:hover,
  .lang[open] summary {
    color: var(--text);
    background: var(--panel-2);
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 176px;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 16px 40px rgba(2, 8, 20, 0.35);
    z-index: 60;
  }

  [data-theme='light'] .lang-menu {
    box-shadow: 0 12px 32px rgba(30, 50, 90, 0.22);
  }

  .lang-menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 12px;
    border-radius: 8px;
    color: var(--muted);
    font-size: 13.5px;
    font-weight: 500;
    white-space: nowrap;
  }

  .lang-menu a:hover {
    color: var(--text);
    background: var(--panel-2);
    text-decoration: none;
  }

  .lang-menu a[aria-current='true'] {
    color: var(--text);
  }

  .lang-menu a[aria-current='true']::after {
    content: '✓';
    font-size: 12px;
    color: var(--accent);
  }

  .lang-short {
    display: none;
  }

  .ico-sun {
    display: none;
  }

  [data-theme='light'] .ico-sun {
    display: block;
  }

  [data-theme='light'] .ico-moon {
    display: none;
  }

  .btn-dl {
    padding: 9px 18px;
    font-size: 14px;
  }

  @media (max-width: 780px) {
    .links {
      display: none;
    }

    .lang summary {
      font-size: 12.5px;
      padding: 0 8px;
    }

    .lang-full {
      display: none;
    }

    .lang .lang-short {
      display: inline;
    }

    .btn-dl {
      padding: 8px 14px;
      font-size: 13px;
    }
  }
</style>
