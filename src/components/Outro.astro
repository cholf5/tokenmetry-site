---
import { site } from '../config/site';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
---

<section id="get" class="full-bleed">
  <div class="container inner">
    <div class="txt">
      <h2>{t.outro.title}</h2>
      <p class="sub">{t.outro.subtitle}</p>
      <div class="ctas">
        <a class="btn btn-primary btn-lg" href={site.releases} target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3.5v12M6.5 10.5 12 16l5.5-5.5M4.5 19.5h15"></path>
          </svg>
          {t.outro.download}</a>
        <a class="btn btn-ghost btn-lg" href={site.repo} target="_blank" rel="noopener">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 4.08 2.63 7.54 6.29 8.76.46.08.63-.2.63-.44v-1.7c-2.55.56-3.09-1.23-3.09-1.23-.42-1.06-1.02-1.34-1.02-1.34-.83-.57.06-.56.06-.56.92.06 1.4.94 1.4.94.82 1.4 2.14 1 2.66.76.08-.6.32-1 .58-1.23-2.01-.23-4.13-1.01-4.13-4.48 0-.99.35-1.8.93-2.44-.09-.23-.4-1.15.09-2.4 0 0 .76-.24 2.48.93a8.6 8.6 0 0 1 4.52 0c1.72-1.17 2.47-.93 2.47-.93.5 1.25.19 2.17.1 2.4.58.64.93 1.45.93 2.44 0 3.48-2.13 4.25-4.15 4.47.33.28.62.84.62 1.7v2.51c0 .24.17.53.64.44A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"></path>
          </svg>
          {t.outro.github}</a>
      </div>
      <p class="note">{t.outro.note}</p>
    </div>

    <div class="run">
      <p class="r-title mono">{t.outro.runTitle}</p>
      <pre class="codeblock mono"><code>{t.outro.run.map((line) => `  ${line}`).join('\n')}</code></pre>
    </div>
  </div>
</section>

<style>
  section {
    padding: 72px 0;
  }

  .inner {
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: 48px;
    align-items: center;
  }

  h2 {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .sub {
    margin-top: 12px;
    color: var(--muted);
    font-size: 15px;
    max-width: 480px;
  }

  .ctas {
    margin-top: 26px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .note {
    margin-top: 18px;
    color: var(--muted);
    font-size: 12.5px;
    max-width: 460px;
  }

  .r-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .codeblock {
    margin: 0;
  }

  .codeblock code {
    color: var(--text);
  }

  @media (max-width: 900px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ctas :global(.btn) {
      width: 100%;
    }
  }
</style>
