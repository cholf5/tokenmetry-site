---
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];

/* 圆点语义 = 读取方式三分类，与 subtitle 口径一致：SQLite 只读（绿）/ 流式解析（蓝）/ 专用格式（橙） */
const familyColors = ['var(--series-0)', 'var(--series-1)', 'var(--series-2)'];
const familyOf = (method: string) => {
  const m = method.toUpperCase();
  if (m.includes('SQLITE')) return 1;
  if (m.includes('JSON')) return 0;
  return 2;
};
---

<section id="sources">
  <div class="container">
    <div class="section-head">
      <span class="kicker">{t.sources.kicker}</span>
      <h2>{t.sources.title}</h2>
      <p class="sub">{t.sources.subtitle}</p>
      <ul class="legend" aria-label={locale === 'zh' ? '读取方式图例' : 'read-method legend'}>
        {t.sources.legend.map((label, i) => (
          <li><span class="dot" style={`--dot:${familyColors[i]}`}></span>{label}</li>
        ))}
      </ul>
    </div>

    <ul class="wall">
      {t.sources.items.map((item) => (
        <li class="cell">
          <span class="dot" style={`--dot:${familyColors[familyOf(item.method)]}`}></span>
          <span class="name">{item.name}</span>
          <span class="method mono">{item.method}</span>
        </li>
      ))}
      <li class="cell count">
        <strong class="num">19</strong>
        <span>{locale === 'zh' ? '源 · 只读' : 'sources · read-only'}</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .section-head {
    max-width: 660px;
    margin-bottom: 40px;
  }

  .section-head h2 {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .section-head .sub {
    margin-top: 10px;
    color: var(--muted);
    font-size: 15px;
  }

  .legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 14px 0 0;
    padding: 0;
    font-size: 12.5px;
    color: var(--muted);
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .wall {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .cell {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--line);
    background: var(--panel);
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13.5px;
    transition: border-color 0.15s ease;
  }

  .cell:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
  }

  .cell .dot {
    width: 7px;
    height: 7px;
  }

  .name {
    font-weight: 600;
    color: var(--text);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .method {
    font-size: 11.5px;
    color: var(--muted);
    white-space: nowrap;
  }

  .cell.count {
    grid-column: 1 / -1;
    justify-content: center;
    gap: 12px;
    border-style: dashed;
    background: transparent;
    color: var(--muted);
    font-size: 13px;
  }

  .cell.count strong {
    font-size: 22px;
    color: var(--text);
    font-weight: 750;
  }

  @media (max-width: 900px) {
    .wall {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .wall {
      grid-template-columns: 1fr;
    }
  }
</style>
