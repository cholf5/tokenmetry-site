---
import { Image } from 'astro:assets';
import { ui, type Locale } from '../i18n/ui';
import sessionsZhDark from '../assets/shots/sessions-zh-dark.png';
import sessionsZhLight from '../assets/shots/sessions-zh-light.png';
import sessionsEnDark from '../assets/shots/sessions-en-dark.png';
import sessionsEnLight from '../assets/shots/sessions-en-light.png';
import modelsZhDark from '../assets/shots/models-zh-dark.png';
import modelsZhLight from '../assets/shots/models-zh-light.png';
import modelsEnDark from '../assets/shots/models-en-dark.png';
import modelsEnLight from '../assets/shots/models-en-light.png';
import timeZhDark from '../assets/shots/time-zh-dark.png';
import timeZhLight from '../assets/shots/time-zh-light.png';
import timeEnDark from '../assets/shots/time-en-dark.png';
import timeEnLight from '../assets/shots/time-en-light.png';
import costZhDark from '../assets/shots/cost-zh-dark.png';
import costZhLight from '../assets/shots/cost-zh-light.png';
import costEnDark from '../assets/shots/cost-en-dark.png';
import costEnLight from '../assets/shots/cost-en-light.png';
import projectsZhDark from '../assets/shots/projects-zh-dark.png';
import projectsZhLight from '../assets/shots/projects-zh-light.png';
import projectsEnDark from '../assets/shots/projects-en-dark.png';
import projectsEnLight from '../assets/shots/projects-en-light.png';
import agentsZhDark from '../assets/shots/agents-zh-dark.png';
import agentsZhLight from '../assets/shots/agents-zh-light.png';
import agentsEnDark from '../assets/shots/agents-en-dark.png';
import agentsEnLight from '../assets/shots/agents-en-light.png';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];

const stopShots: Record<string, { dark: ImageMetadata; light: ImageMetadata }> = {
  sessions: locale === 'zh' ? { dark: sessionsZhDark, light: sessionsZhLight } : { dark: sessionsEnDark, light: sessionsEnLight },
  models: locale === 'zh' ? { dark: modelsZhDark, light: modelsZhLight } : { dark: modelsEnDark, light: modelsEnLight },
  time: locale === 'zh' ? { dark: timeZhDark, light: timeZhLight } : { dark: timeEnDark, light: timeEnLight },
  cost: locale === 'zh' ? { dark: costZhDark, light: costZhLight } : { dark: costEnDark, light: costEnLight },
  projects: locale === 'zh' ? { dark: projectsZhDark, light: projectsZhLight } : { dark: projectsEnDark, light: projectsEnLight },
  agents: locale === 'zh' ? { dark: agentsZhDark, light: agentsZhLight } : { dark: agentsEnDark, light: agentsEnLight },
};

const alts: Record<string, string> = {
  sessions: locale === 'zh' ? 'Tokenmetry 会话明细视图：Agent、主模型、项目、token 与成本逐行的表格，带搜索与筛选' : 'Tokenmetry sessions view: a table of agent, model, project, tokens and cost per session, with search and filters',
  models: locale === 'zh' ? 'Tokenmetry 模型统计视图：模型、厂商、关联 Agent 与成本占比表格' : 'Tokenmetry models view: models, providers, associated agents and cost shares',
  time: locale === 'zh' ? 'Tokenmetry 时间分析视图：时间 KPI、按小时分布图、星期分布与活跃日历' : 'Tokenmetry time analysis: time KPIs, hourly distribution, weekday spread and activity calendar',
  cost: locale === 'zh' ? 'Tokenmetry 成本分析视图：成本 KPI、日成本趋势与构成' : 'Tokenmetry cost analysis: cost KPIs, daily trend and composition',
  projects: locale === 'zh' ? 'Tokenmetry 项目统计视图：项目占比与会话排行' : 'Tokenmetry projects view: shares and session rankings',
  agents: locale === 'zh' ? 'Tokenmetry Agent 统计视图：Top KPI 与 Agent 排行' : 'Tokenmetry agents view: top KPIs and agent rankings',
};

const fullStops = t.tour.stops.filter((s) => s.layout === 'full');
const splitStops = t.tour.stops.filter((s) => s.layout === 'split');
const duoStops = t.tour.stops.filter((s) => s.layout === 'duo');
---

<section id="views">
  <div class="container">
    <div class="section-head">
      <span class="kicker">{t.tour.kicker}</span>
      <h2>{t.tour.title}</h2>
      <p class="sub">{t.tour.subtitle}</p>
    </div>

    {fullStops.map((stop) => (
      <article class="stop full" style={`--acc:var(--series-${stop.accent})`}>
        <header class="stop-head">
          <span class="no mono num">{stop.no}<em>/09</em></span>
          <div>
            <span class="view">{stop.view}</span>
            <h3>{stop.title}</h3>
          </div>
        </header>
        <div class="visual theme-dual">
          <Image src={stopShots[stop.visual].dark} alt={alts[stop.visual]} widths={[880, 1280]} sizes="(max-width: 1140px) 100vw, 1032px" format="webp" class="t-dark" loading="lazy" />
          <Image src={stopShots[stop.visual].light} alt="" aria-hidden="true" widths={[880, 1280]} sizes="(max-width: 1140px) 100vw, 1032px" format="webp" class="t-light" loading="lazy" />
        </div>
        <p class="desc">{stop.desc}</p>
      </article>
    ))}

    <div class="splits">
      {splitStops.map((stop) => (
        <article class:list={['stop', 'split', { flip: stop.flip }]} style={`--acc:var(--series-${stop.accent})`}>
          <div class="txt">
            <span class="no mono num">{stop.no}<em>/09</em></span>
            <span class="view">{stop.view}</span>
            <h3>{stop.title}</h3>
            <p class="desc">{stop.desc}</p>
          </div>
          <div class="visual theme-dual">
            <Image src={stopShots[stop.visual].dark} alt={alts[stop.visual]} widths={[640, 900]} sizes="(max-width: 900px) 100vw, 560px" format="webp" class="t-dark" loading="lazy" />
            <Image src={stopShots[stop.visual].light} alt="" aria-hidden="true" widths={[640, 900]} sizes="(max-width: 900px) 100vw, 560px" format="webp" class="t-light" loading="lazy" />
          </div>
        </article>
      ))}
    </div>

    <div class="duo">
      {duoStops.map((stop) => (
        <article class="stop mini" style={`--acc:var(--series-${stop.accent})`}>
          <span class="no mono num">{stop.no}<em>/09</em></span>
          <span class="view">{stop.view}</span>
          <h3>{stop.title}</h3>
          <p class="desc">{stop.desc}</p>
          <div class="visual theme-dual">
            <Image src={stopShots[stop.visual].dark} alt={alts[stop.visual]} widths={[520, 760]} sizes="(max-width: 900px) 100vw, 480px" format="webp" class="t-dark" loading="lazy" />
            <Image src={stopShots[stop.visual].light} alt="" aria-hidden="true" widths={[520, 760]} sizes="(max-width: 900px) 100vw, 480px" format="webp" class="t-light" loading="lazy" />
          </div>
        </article>
      ))}
    </div>

    <p class="more mono">{t.tour.more}</p>
  </div>
</section>

<style>
  .section-head {
    max-width: 680px;
    margin-bottom: 46px;
  }

  .section-head h2 {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .section-head .sub {
    margin-top: 10px;
    color: var(--muted);
    font-size: 15px;
  }

  .no {
    font-size: 17px;
    font-weight: 700;
    color: var(--acc);
  }

  .no em {
    font-style: normal;
    font-size: 12px;
    color: var(--muted);
  }

  .view {
    display: inline-block;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--muted);
    border: 1px solid var(--line);
    background: var(--panel);
    border-radius: 999px;
    padding: 3px 11px;
  }

  /* 满宽特写 */
  .stop.full {
    margin-bottom: 64px;
  }

  .stop-head {
    display: flex;
    align-items: flex-end;
    gap: 18px;
    margin-bottom: 18px;
  }

  .stop-head h3 {
    font-size: 24px;
    font-weight: 720;
    letter-spacing: -0.02em;
    margin-top: 8px;
  }

  .full .visual {
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 22px 54px rgba(2, 8, 20, 0.28);
  }

  [data-theme='light'] .full .visual {
    box-shadow: 0 18px 40px rgba(30, 50, 90, 0.14);
  }

  .full .desc {
    margin-top: 16px;
    color: var(--muted);
    font-size: 14.5px;
    max-width: 680px;
  }

  /* 分栏交替 */
  .splits {
    display: flex;
    flex-direction: column;
    gap: 56px;
    margin-bottom: 56px;
  }

  .stop.split {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 40px;
    align-items: center;
  }

  .stop.split.flip {
    grid-template-columns: 7fr 5fr;
  }

  .stop.split.flip .txt {
    order: 2;
  }

  .stop.split.flip .visual {
    order: 1;
  }

  .split .txt .no {
    display: block;
    margin-bottom: 10px;
  }

  .split .txt .view {
    margin-bottom: 10px;
  }

  .split h3 {
    font-size: 23px;
    font-weight: 720;
    letter-spacing: -0.02em;
    margin-top: 10px;
  }

  .split .desc {
    margin-top: 12px;
    color: var(--muted);
    font-size: 14.5px;
  }

  .split .visual {
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 20px 48px rgba(2, 8, 20, 0.26);
  }

  [data-theme='light'] .split .visual {
    box-shadow: 0 16px 36px rgba(30, 50, 90, 0.13);
  }

  /* 双小卡收尾 */
  .duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 40px;
  }

  .stop.mini {
    background: var(--panel);
    border: 1px solid var(--line);
    border-top: 2px solid var(--acc);
    border-radius: 14px;
    padding: 22px;
  }

  .mini .no {
    display: inline-block;
    margin-right: 8px;
  }

  .mini h3 {
    font-size: 18px;
    font-weight: 700;
    margin-top: 10px;
  }

  .mini .desc {
    margin-top: 8px;
    color: var(--muted);
    font-size: 13.5px;
  }

  .mini .visual {
    margin-top: 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }

  .more {
    color: var(--muted);
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .stop.split,
    .stop.split.flip {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .stop.split.flip .txt {
      order: 1;
    }

    .stop.split.flip .visual {
      order: 2;
    }

    .duo {
      grid-template-columns: 1fr;
    }
  }
</style>
