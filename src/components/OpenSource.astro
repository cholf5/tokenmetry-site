---
import { site } from '../config/site';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
---

<section id="open-source">
  <div class="container">
    <div class="card">
      <div class="head">
        <h2>{t.open.title}</h2>
        <span class="chip num">AGPL-3.0</span>
      </div>
      <p class="body">{t.open.body}</p>
      <ul class="points">
        {t.open.points.map((p) => (
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m4.5 12.5 5 5 10-11"></path>
            </svg>
            {p}
          </li>
        ))}
      </ul>
      <a class="btn btn-ghost" href={site.repo} target="_blank" rel="noopener">{t.open.cta}</a>
    </div>
  </div>
</section>

<style>
  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 44px 46px;
    max-width: 860px;
    margin: 0 auto;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  h2 {
    font-size: 28px;
    letter-spacing: -0.02em;
  }

  .chip {
    font-size: 12px;
    font-weight: 600;
    color: var(--link);
    background: var(--chip-bg);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 12px;
  }

  .body {
    margin-top: 16px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.75;
    max-width: 680px;
  }

  .points {
    list-style: none;
    margin: 22px 0 26px;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .points li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14.5px;
    color: var(--text);
  }

  .points svg {
    color: var(--green);
    flex: 0 0 auto;
  }

  @media (max-width: 640px) {
    .card {
      padding: 30px 22px;
    }

    h2 {
      font-size: 23px;
    }
  }
</style>
