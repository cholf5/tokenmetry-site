---
/** 品牌标：渐变圆角方块 + T，与产品托盘原型 logo 同源 */
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
const id = `lg-${size}`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  role="img"
  aria-label="Tokenmetry"
>
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#3986ed"></stop>
      <stop offset="1" stop-color="#8a68e9"></stop>
    </linearGradient>
  </defs>
  <rect width="24" height="24" rx="6.5" fill={`url(#${id})`}></rect>
  <path
    d="M7 8.4h10M12 8.4V17"
    stroke="#fff"
    stroke-width="2.1"
    stroke-linecap="round"></path>
</svg>
