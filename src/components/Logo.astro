---
/** 品牌标：定稿应用图标 v1 绿柱，几何与 src/assets/brand/app-icon.svg 同源（改图标两处同步） */
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
const id = `tk-${size}`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 1024 1024"
  role="img"
  aria-label="Tokenmetry"
>
  <defs>
    <linearGradient id={id} x1="150" y1="0" x2="874" y2="1024" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#14263f"></stop>
      <stop offset="1" stop-color="#0a1322"></stop>
    </linearGradient>
  </defs>
  <rect width="1024" height="1024" rx="239" fill={`url(#${id})`}></rect>
  <rect x="177" y="530" width="170" height="290" rx="85" fill="#1d9e79"></rect>
  <rect x="427" y="365" width="170" height="455" rx="85" fill="#27c496"></rect>
  <rect x="677" y="200" width="170" height="620" rx="85" fill="#38d6a4"></rect>
</svg>
